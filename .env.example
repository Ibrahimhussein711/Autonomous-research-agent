# ============================================================
# LLM — local Ollama (no API key needed; Groq is no longer used)
# ============================================================
# Must already be pulled locally (`ollama list` to check, `ollama pull
# qwen2:latest` if missing). main.py verifies this is reachable and the
# model exists before running the pipeline.
OLLAMA_MODEL=qwen2:latest
OLLAMA_BASE_URL=http://localhost:11434

# ============================================================
# Tavily (web search — unchanged, still required)
# ============================================================
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=3

# ============================================================
# Research limits
# ============================================================
MAX_SEARCHES_PER_TASK=3
MAX_RESEARCH_ROUNDS=3
MAX_TOTAL_SEARCHES=20
MAX_FINDINGS=8

# ============================================================
# Output length control (maps to Ollama's num_predict per call)
# ============================================================
# Per-call-type caps so a small tool-call-decision step doesn't ask for
# as many tokens as a full report narrative — also just faster locally.
MAX_OUTPUT_TOKENS=1200
PLANNER_MAX_OUTPUT_TOKENS=700
RESEARCHER_STEP_MAX_OUTPUT_TOKENS=300
EXTRACTION_MAX_OUTPUT_TOKENS=900
REVIEWER_MAX_OUTPUT_TOKENS=600
NARRATIVE_MAX_OUTPUT_TOKENS=1000

MAX_SEARCH_RESULT_CHARS=1000
# Shorter snippet echoed back into the researcher's own conversation
# (vs. the full snippet above, which only feeds evidence extraction) —
# keeps the conversation compact, which matters more on a smaller local
# model's context window than it did on a hosted one.
MAX_SEARCH_SNIPPET_CHARS_FOR_LLM=220
MAX_CONTEXT_CHARS=9000

# ============================================================
# Retry / error handling
# ============================================================
# No rate limits with a local server, but Ollama can still be briefly
# unavailable (e.g. loading the model into memory) or time out on a slow
# machine, so bounded retries are still worth having.
PLANNER_MAX_RETRIES=3
RESEARCHER_MAX_RETRIES=3
REVIEWER_MAX_RETRIES=3
NARRATIVE_MAX_RETRIES=2
RETRY_BASE_DELAY=2.0
RETRY_MAX_DELAY=30.0

# ============================================================
# Output
# ============================================================
REPORTS_DIR=reports
